from pipeline import *
import matplotlib.pyplot as plt

coffee_cup = Model('coffee_cup_obj.obj')
transparent_cup = Model('coffee_cup_obj.obj')

# 모델들을 노드에 추가
all_node = Node()
coffee_cup_node = Node(coffee_cup)
transparent_cup_node = Node(transparent_cup)

# 메모리 공유 버그 방지 (조명 객체를 노드마다 따로 생성)
my_light_1 = Pointlight(Vector3(0, 0, 0), Color(255, 255, 255), intensity=5)
light_node_1 = Node(light=my_light_1)
light_node_1.local_position = Vector3(1, 2, 0)

my_light_2 = Pointlight(Vector3(0, 0, 0), Color(255, 255, 255), intensity=5)
light_node_2 = Node(light=my_light_2)
light_node_2.local_position = Vector3(-1, 10, 0)

# 최상위 노드에 모든 자식 부착
all_node.add_child(coffee_cup_node)
all_node.add_child(transparent_cup_node)
all_node.add_child(light_node_1)
all_node.add_child(light_node_2)

# 노드 변형
coffee_cup_node.local_position = Vector3(0,0,-3)
transparent_cup_node.local_position = Vector3(0.2,0.5,-1.5)
rotation = Quaternion().axis_angle(Vector3(1,1,1), 60)
coffee_cup_node.local_rotation = rotation

# 변형 적용 (연쇄 업데이트)
all_node.update_transform()

# 스카이박스 및 텍스처 설정
skybox = Model('skybox_minecraft.obj')
skybox_diffuse = Texture('skybox_minecraft_texture.png')
diffuse = Texture('coffee_cup_texture.png')
normal = Texture('coffee_cup_normal.png')
specular = Texture('coffee_cup_metallic.png')

# 렌더러 엔진 가동
renderer = Pipeline(1920, 1080)
renderer.clear()

# 조명 수집 (Light Gathering)
# 렌더링하기 직전에 씬(all_node)을 훑어서 조명을 파이프라인에 넣어줍니다.
renderer.lights = []
for node in all_node.children:
    if node.light is not None:
        # 빛 노드의 최종 월드 위치를 실제 조명 연산 좌표로 동기화
        if isinstance(node.light, Pointlight):
            node.light.position = node.get_world_position()

        # 파이프라인의 조명 리스트에 쏙 넣어줌
        renderer.lights.append(node.light)


# 리스트 분리
opaque_objects = [coffee_cup_node]
transparent_objects = [transparent_cup_node]

# 카메라 세팅 변경 (카메라를 뒤로 띄우고 살짝 회전)
renderer.camera.eye = Vector3(2, 1, 3) # 적절한 거리로 배치

#스카이박스 렌더링
renderer.render_skybox(skybox, skybox_diffuse)

#메쉬 렌더링 지시
#추가: 투명/불투명마다 다른 렌더링 과정
for obj in opaque_objects:
  renderer.render_mesh(obj.model, diffuse, normal, specular, world_matrix = obj.world_matrix)

transparent_objects.sort(key=lambda n: n.get_world_position().minus(renderer.camera.eye).magnitude(), reverse=True)

for obj in transparent_objects:
  renderer.render_mesh(obj.model, diffuse, normal, specular, world_matrix = obj.world_matrix, object_alpha = 0.5)

# 결과물 출력
result_image = renderer.show()
display(result_image)
